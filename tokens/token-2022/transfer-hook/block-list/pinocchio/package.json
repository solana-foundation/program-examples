{
  "name": "block-list",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "generate-sdks": "pnpx tsx codama.ts",
    "build": "cargo build-sbf --manifest-path=./program/Cargo.toml --sbf-out-dir=./tests/fixtures",
    "test": "cargo test -p block-list",
    "build-and-test": "pnpm generate-sdks && pnpm exec tsc --noEmit -p tsconfig.json && pnpm build && pnpm test"
  },
  "dependencies": {
    "@codama/renderers": "^1.0.19",
    "@solana/kit": "^7.0.0",
    "codama": "^1.3.6",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.29"
  }
}
