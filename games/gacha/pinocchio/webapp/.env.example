# Default cluster the app opens on: solana:devnet | solana:mainnet | solana:localnet
VITE_DEFAULT_CLUSTER=solana:devnet

# Featured pool: the admin whose pool the home page shows. If unset, the app
# discovers pools on-chain and shows the first one.
VITE_POOL_ADMIN=

# Optional mainnet RPC (public mainnet-beta is heavily rate-limited).
VITE_MAINNET_RPC_URL=

# Optional custom devnet RPC (e.g. a Helius endpoint). Falls back to
# api.devnet.solana.com when unset.
VITE_DEVNET_RPC_URL=
