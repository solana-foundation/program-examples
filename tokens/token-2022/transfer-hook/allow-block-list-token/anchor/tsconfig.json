{
    "compilerOptions": {
        "types": ["mocha", "chai", "node"],
        "lib": ["esnext"],
        "module": "esnext",
        "target": "esnext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "skipLibCheck": true
    }
}
