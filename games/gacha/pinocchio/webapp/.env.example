# Browser-safe devnet RPC used for reads and wallet transaction preparation.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional client-side pool discovery hint. The API still enforces GACHA_POOL_ADDRESS.
NEXT_PUBLIC_POOL_ADMIN=
NEXT_PUBLIC_DEFAULT_CLUSTER=devnet

# Photon-capable devnet endpoint used only by POST /api/pull.
SOLANA_RPC_URL=

# Pool processed by POST /api/pull.
GACHA_POOL_ADDRESS=

# Base64 encoding of the operator's 64-byte Solana keypair. Never prefix this
# variable with NEXT_PUBLIC_. Store it as a Sensitive variable on Vercel.
OPERATOR_KEYPAIR_BASE64=
