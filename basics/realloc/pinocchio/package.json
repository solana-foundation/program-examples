{
  "type": "module",
  "scripts": {
    "test": "mocha --import=tsx -t 1000000 ./tests/realloc.test.ts",
    "build-and-test": "cargo build-sbf --manifest-path=./program/Cargo.toml --sbf-out-dir=./tests/fixtures && pnpm test",
