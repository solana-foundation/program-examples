{
  "name": "block-list",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "generate-sdks": "pnpx tsx codama.ts",
    "build": "cargo build-sbf --manifest-path=./program/Cargo.toml --sbf-out-dir=./tests/fixtures",
    "test": "cargo test -p block-list",
    "build-and-test": "pnpm generate-sdks && pnpm exec tsc --noEmit -p tsconfig.json && pnpm build && cargo build -p block-list-cli && pnpm test"
  },
  "dependencies": {
    "@solana/kit": "^8.5.0",
    "codama": "^1.11.0",
    "tsx": "^4.23.15",
    "@codama/renderers-js": "^2.8.0",
    "@codama/renderers-rust": "^3.1.3",
    "@solana/program-client-core": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
