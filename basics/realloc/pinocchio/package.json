    "deploy": "solana program deploy ./program/target/so/program.so"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "fs": "^0.0.1-security"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.2",
    "litesvm": "^0.8.0",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3",
    "@types/node": "^26.1.0",
    "tsx": "^4.19.2"
  }
}
